/* ===== المدرج (SVG) ===== */
.score-svg { display:block; width:100%; direction:ltr; user-select:none; -webkit-user-select:none; touch-action:none; overflow:visible; color:var(--ink,#1d2433); }
.score-svg .st-line { stroke:#2c3a4f; stroke-width:1.2; }
.score-svg .st-bar { stroke:#2c3a4f; stroke-width:1.5; }
.score-svg .st-ledger { stroke:currentColor; stroke-width:1.5; }
.score-svg .gl { fill:currentColor; }
.score-svg .clef, .score-svg .ly-staff .gl { fill:#1d2433; }
.score-svg .st-time { font-family:"Times New Roman",Georgia,serif; font-weight:900; fill:#1d2433; }
.score-svg .m-num { font-family:Cairo,sans-serif; font-weight:800; fill:#2d6cdf; }
.score-svg .m-text { font-family:"Segoe UI Symbol","Noto Music",Georgia,serif; font-style:italic; font-weight:700; fill:#1d2433; }
.score-svg .head { fill:currentColor; }
.score-svg .head.unp { fill:#fff; stroke:#94a3b8; stroke-width:1.6; stroke-dasharray:3 2; }
.score-svg .unp-q { font-family:Cairo,sans-serif; font-weight:900; fill:#f59e0b; }
.score-svg .stem { stroke:currentColor; stroke-width:1.6; }
.score-svg .hit { fill:transparent; }
.score-svg .nt { cursor:pointer; transition:color .15s; }
.score-svg .nt.sel { color:#2563eb; }
.score-svg .nt.sel .hit { fill:rgba(37,99,235,.10); }
.score-svg .nt.playing { color:#0ea5e9; }
.score-svg .nt.dim { opacity:.35; }
.score-svg .nt.st-ok { color:#059669; }
.score-svg .nt.st-pitch { color:#dc2626; }
.score-svg .nt.st-rhythm { color:#d97706; }
.score-svg .nt.st-wrong { color:#dc2626; }
.score-svg .nt.st-extra { color:#9333ea; }
.score-svg .nt.st-extra .hit { fill:rgba(147,51,234,.08); }
.score-svg .nt.quiz .hit { fill:rgba(245,158,11,.22); stroke:#f59e0b; stroke-width:2; rx:8; }
.score-svg .playhead { fill:rgba(14,165,233,.13); stroke:rgba(14,165,233,.45); stroke-width:1.5; transition:x .08s linear; }
.score-svg .m-warn { fill:rgba(251,146,60,.13); stroke:rgba(234,88,12,.5); stroke-dasharray:5 4; }
.score-svg .m-warn-text { font-family:Cairo,sans-serif; font-weight:800; fill:#c2410c; }
.score-svg .m-ok { fill:rgba(16,185,129,.10); }
.score-svg .m-bad { fill:rgba(239,68,68,.08); }
.score-svg .lbl { font-family:Cairo,sans-serif; font-weight:800; fill:#334155; }
.score-svg .lbl.playing { fill:#0284c7; font-weight:900; }
.score-svg .lbl-rest { fill:#94a3b8; font-weight:600; }
.score-svg .lbl-unp { fill:#f59e0b; }
.score-svg .lbl-hidden { fill:#cbd5e1; }
.score-svg .lbl-shape { font-family:Cairo,sans-serif; font-weight:700; fill:#7c3aed; }
.score-svg .shape-br { fill:none; stroke:#a78bfa; stroke-width:1.4; }
.score-svg .caret-line { stroke:#2563eb; stroke-width:2.2; stroke-dasharray:4 3; animation:caretBlink 1.1s steps(2) infinite; }
.score-svg .caret-tri { fill:#2563eb; }
.score-svg .remain { font-family:Cairo,sans-serif; font-weight:800; fill:#2563eb; }
@keyframes caretBlink { 50% { opacity:.25; } }
.score-svg .ghost-head { fill:rgba(37,99,235,.45); }
.score-svg .ghost-ledger { stroke:rgba(37,99,235,.6); stroke-width:1.5; }
.score-svg .ghost-guide { stroke:rgba(37,99,235,.35); stroke-width:1; stroke-dasharray:3 3; }
.score-svg .ghost-tip-bg { fill:#1e3a8a; }
.score-svg .ghost-tip { fill:#fff; font-family:Cairo,sans-serif; font-weight:800; }
.score-svg .tie { fill:currentColor; }
.score-svg .nt.sel .head.unp { stroke:#2563eb; stroke-width:2.4; fill:#dbeafe; }
